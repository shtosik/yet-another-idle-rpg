{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npx ng build*)",
      "Bash(npx tsc *)",
      "Bash(node scripts/*)",
      "Bash(git worktree add *)",
      "Bash(git worktree list)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "PowerShell(npm run *)",
      "PowerShell(npx ng build*)",
      "PowerShell(npx tsc *)",
      "PowerShell(node scripts/*)",
      "PowerShell(git worktree add *)",
      "PowerShell(git worktree list)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"SessionStart\",\"additionalContext\":\"Angular repo: before writing or reviewing Angular code (components, templates, signals, stores, routing, forms, tests), load the angular-developer skill with the Skill tool once per session.\"}}'"
          }
        ]
      }
    ]
  }
}
