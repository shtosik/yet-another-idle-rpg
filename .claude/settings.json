{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npx ng build*)",
      "Bash(npx tsc *)",
      "Bash(node scripts/*)",
      "Bash(git worktree add *)",
      "Bash(git worktree list)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "PowerShell(npm run *)",
      "PowerShell(npx ng build*)",
      "PowerShell(npx tsc *)",
      "PowerShell(node scripts/*)",
      "PowerShell(git worktree add *)",
      "PowerShell(git worktree list)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "EnterWorktree"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|EnterWorktree|.*javascript_tool",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\""
          }
        ]
      }
    ]
  }
}
